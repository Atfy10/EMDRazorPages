@page
@model EmployeeManagementDashboard.Pages.EmployeePages.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>

<form method="get" class="mb-3">
    <div class="input-group">
        <input type="text" class="form-control" name="SearchString" value="@Model.SearchString" placeholder="Search by name, email, phone, or department..." />
        <button type="submit" class="btn btn-primary">Search</button>
    </div>
</form>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Employees[0].FirstName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Employees[0].LastName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Employees[0].Email)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Employees[0].Phone)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Employees[0].Department)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Employees[0].Position)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Employees[0].Salary)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Employees[0].HireDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Employees[0].IsActive)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Employees)
        {
            <tr>
                <td>
                    @Html.DisplayFor(model => item.FirstName)
                </td>
                <td>
                    @Html.DisplayFor(model => item.LastName)
                </td>
                <td>
                    @Html.DisplayFor(model => item.Email)
                </td>
                <td>
                    @Html.DisplayFor(model => item.Phone)
                </td>
                <td>
                    @Html.DisplayFor(model => item.Department)
                </td>
                <td>
                    @Html.DisplayFor(model => item.Position)
                </td>
                <td>
                    @Html.DisplayFor(model => item.Salary)
                </td>
                <td>
                    @Html.DisplayFor(model => item.HireDate)
                </td>
                <td>
                    @Html.DisplayFor(model => item.IsActive)
                </td>
                <td>
                    <a asp-page="./Edit" asp-route-id="@item.Id">Edit</a> |
                    <a asp-page="./Details" asp-route-id="@item.Id">Details</a> |
                    <a asp-page="./Delete" asp-route-id="@item.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <script>
        const searchInput = document.querySelector('input[name="SearchString"]');

        let timeOut;

        searchInput.addEventListener('input', function () {
            clearTimeout(timeOut);

            timeOut = setTimeout(() => {
                const searchTerm = this.value.trim();

                const url = new URL(window.location.href);

                if (searchTerm) {
                    url.searchParams.set('SearchString', searchTerm);
                } else {
                    url.searchParams.delete('SearchString');
                }

                window.location.href = url.toString();
            }, 700);
        });
    </script>
}